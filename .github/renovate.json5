{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  enabled: false,
  reviewersFromCodeOwners: true,
  dependencyDashboard: true,
  semanticCommitType: 'fix',
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchCurrentVersion: '!/^0/',
      automerge: true,
    },
  ],
}
